{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "objectWrap": "preserve",
  "insertFinalNewline": true,
  "sortImports": true,
  "sortPackageJson": true,
  "ignorePatterns": [
    "**/dist/**",
    "**/target/**",
    "**/.wrangler/**",
    "**/*.md",
    "**/docs/telemetry/**",
    "herdr-telemetry-*/**"
  ]
}
